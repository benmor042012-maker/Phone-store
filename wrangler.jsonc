{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phone-store",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-20",
  // The store's content lives here: the admin panel publishes into it and the storefront
  // reads it back. Same namespace the original Worker used, so published content carries
  // over. The admin password is a secret, not config:  npx wrangler secret put ADMIN_PASSWORD
  "kv_namespaces": [
    { "binding": "STORE", "id": "f22b4b9676244f19bc4d7e02a173d96a" }
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees every request. It used to run only for the API, the uploads and the
    // sitemap, with the CDN answering everything else itself; but the www → apex redirect
    // and the 404 status for a path that is not a page have to happen before an asset is
    // served, and there is no path pattern that names "every request on the www host".
    // The Worker still hands each asset straight to the CDN, so the cost is one hop.
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
