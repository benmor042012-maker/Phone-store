{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "phone-store",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-08-20",
  // The store's content lives here: the admin panel publishes into it and the storefront
  // reads it back. Same namespace the original Worker used, so published content carries
  // over. The admin password is a secret, not config:  npx wrangler secret put ADMIN_PASSWORD
  "kv_namespaces": [
    { "binding": "STORE", "id": "f22b4b9676244f19bc4d7e02a173d96a" }
  ],
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Without this the asset router answers these paths itself and the Worker never runs.
    // /sitemap.xml has a static file next to it, which was being served instead of the
    // generated one, so search engines only ever saw the home page. Anything not listed
    // is still served straight from the CDN.
    "run_worker_first": ["/api/*", "/img/*", "/sitemap.xml"]
  },
  "observability": {
    "enabled": true
  }
}
